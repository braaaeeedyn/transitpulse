# TransitPulse on the Oracle VM: environment for both systemd units.
# bootstrap.sh copies this to /etc/transitpulse/transitpulse.env (root, mode 600) only if that file doesn't exist,
# and fills in JAVA_HOME for the machine. Edit the copy on the VM, never this example.
# No secrets here: the service-account key is a separate file, referenced by path below.

# warehouse mode: upload raw files to GCS and load BigQuery; dbt builds the `dev` target (datasets staging/marts)
TP_PIPELINE_MODE=gcp
TP_GCP_PROJECT=transitpulse-511002
TP_RAW_BUCKET=transitpulse-511002-raw
DBT_TARGET=dev

# the sa-pipeline key, copied to the VM with scp (owner transitpulse, mode 600). See docs/ORACLE_VM.md.
GOOGLE_APPLICATION_CREDENTIALS=/etc/transitpulse/sa-pipeline-key.json

# Dagster instance (run history, schedules); bootstrap.sh copies pipeline/dagster.yaml into it
DAGSTER_HOME=/var/lib/transitpulse/dagster_home
# web UI port on 127.0.0.1 (SSH tunnel: ssh -L 3000:127.0.0.1:3000 <vm>)
TP_DAGSTER_PORT=3000

# Spark runs in-process with the distro's Java 17 (no Docker on the VM)
TP_SPARK_RUNNER=python
# Spark driver heap; the daemon unit's MemoryMax (7G) must stay ~2 GB above it
TP_SPARK_DRIVER_MEMORY=4g

# threads: match the VM's OCPUs (2 on the Always Free maximum), so jobs don't fight SeismicSoCal for CPU
TP_ML_THREADS=2
DBT_THREADS=2
JAVA_HOME=/usr/lib/jvm/java-17-openjdk-arm64

# local working files (downloads, Parquet before upload)
TP_DATA_ROOT=/opt/transitpulse/data/parquet
TP_DUCKDB_PATH=/opt/transitpulse/data/transitpulse.duckdb
