# Build context for the root Dockerfile (the API image) and pipeline/spark/Dockerfile (which copies nothing).
# Allowlist: everything is excluded, then only what the API image needs is let back in.
*
!pyproject.toml
!uv.lock
!.python-version
!api/
!web/

# never in an image, even if a path above would let it in
**/__pycache__
**/*.py[cod]
**/.env
**/.env.*
**/*-key.json
**/*.keyfile.json
data/
credentials/
.git
node_modules
tests
.venv
.loop*
